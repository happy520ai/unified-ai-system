{
  "name": "@unified-ai-system/agent-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "dependencies": {
    "@unified-ai-system/shared-sdk": "workspace:*",
    "@unified-ai-system/shared-utils": "workspace:*"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "check": "node --check ./src/index.js && node --check ./src/entrypoints/verifyNvidiaServiceChain.js && node --check ./src/entrypoints/verifyErrorHandling.js && node --check ./src/entrypoints/verifyStreamingChain.js && node --check ./src/entrypoints/verifyKnowledgeServiceChain.js",
    "build": "pnpm run check",
    "test:service-chain": "node ./src/entrypoints/verifyNvidiaServiceChain.js && node ./src/entrypoints/verifyErrorHandling.js && node ./src/entrypoints/verifyStreamingChain.js && node ./src/entrypoints/verifyKnowledgeServiceChain.js"
  }
}
