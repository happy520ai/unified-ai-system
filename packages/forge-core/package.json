{
  "name": "@unified-ai-system/forge-core",
  "version": "0.5.0",
  "description": "Forge — Goal-driven autonomous coding engine, deeply integrated with unified-ai-system",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./integration/forge-routes.js": "./src/integration/forge-routes.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 test/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=json-summary node --test --test-concurrency=4 test/*.test.js",
    "test:coverage:check": "c8 --check-coverage --lines 60 --branches 40 --functions 50 node --test --test-concurrency=4 test/*.test.js",
    "rebuild:native": "node ./scripts/rebuild-native.mjs --force",
    "postinstall": "node ./scripts/rebuild-native.mjs"
  },
  "dependencies": {
    "@unified-ai-system/shared-utils": "workspace:*",
    "@unified-ai-system/shared-contracts": "workspace:*",
    "@unified-ai-system/shared-config": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "chalk": "^6.0.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
