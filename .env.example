# Unified AI System — environment template.
# Copy to `.env` and fill in only what you need. Never commit real secrets.
#
# SAFE DEFAULT: the gateway starts in fake-provider mode and makes NO external
# calls. The real-provider settings below are opt-in and commented out.

# ── Local-only (fake provider) — the safe default ─────────────────────────
# No keys required. The gateway serves deterministic fake responses.
AI_GATEWAY_PROVIDER_MODE=fake
AI_GATEWAY_REAL_PROVIDER_ENABLED=false

# ── Real provider (opt-in) — uncomment and fill a key to go live ──────────
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=
# MIMO_API_KEY=
# MIMO_MODEL=
# MIMO_BASE_URL=
# GEMINI_API_KEY=
# AI_GATEWAY_PROVIDER_MODE=real
# AI_GATEWAY_REAL_PROVIDER_ENABLED=true
# AI_GATEWAY_DEFAULT_PROVIDER=nvidia
# AI_GATEWAY_DEFAULT_MODEL=
# AI_GATEWAY_ENABLED_PROVIDERS=nvidia

# ── Common runtime ────────────────────────────────────────────────────────
AI_GATEWAY_ROUTE_MODE=fixed

# Non-loopback binding requires PME enterprise authentication and fails closed otherwise.
AI_GATEWAY_SERVICE_HOST=127.0.0.1
AI_GATEWAY_SERVICE_PORT=3100
AI_GATEWAY_SERVICE_URL=http://127.0.0.1:3100

# Local-client inventory and route planning are protected control-plane routes.
# Process observation never grants trust or execution. Real client execution is
# unavailable until a governed adapter, approval, and external-effect fence exist.
AI_GATEWAY_LOCAL_CLIENT_EXECUTION_ENABLED=false
# Real execution requires rollbackResistant authority by default. The current
# SQLite epoch detects registry-only replay but is not a separately protected
# anchor. Set this true only for an explicitly accepted trusted-user/single-host
# downgrade; never use it to claim production rollback resistance.
AI_GATEWAY_LOCAL_CLIENT_ALLOW_REGISTRY_ONLY_ROLLBACK_DETECTION=false
AI_GATEWAY_LOCAL_CLIENT_STALE_THRESHOLD_MS=300000
AI_GATEWAY_LOCAL_CLIENT_MAX_ALTERNATIVES=5
# Provider-route policy is server-owned: request bodies cannot supply provider
# inventory or policy facts. Empty selects the secure internal-data default with
# fan-out 1 and Fusion disabled; use the commented versioned JSON shape for
# explicit tenant/client overrides.
AI_GATEWAY_LOCAL_CLIENT_PROVIDER_POLICIES_JSON=
# AI_GATEWAY_LOCAL_CLIENT_PROVIDER_POLICIES_JSON={"version":1,"defaultPolicy":{"dataClass":"internal","maxFanout":1,"fusionAllowed":false},"overrides":[]}
# Managed protocol routing is never selected by request body alone. Use a
# dedicated enterprise credential with role=local_client, then bind its exact
# tenant/subject to one configured loopback client; never deploy an admin or
# operator credential inside a client application.
# the body client id must repeat this server-owned binding and present PoP.
AI_GATEWAY_LOCAL_CLIENT_PROTOCOL_PRINCIPALS_JSON=
# AI_GATEWAY_LOCAL_CLIENT_PROTOCOL_PRINCIPALS_JSON={"version":1,"bindings":[{"tenantId":"<tenant-id>","subjectId":"<authenticated-subject-id>","clientId":"managed.local-client"}]}
# Optional autonomous discovery/maintenance scheduler. It is disabled by
# default and is hard-wired to dry-run: no APPLY/ENABLE_APPLY environment
# switch exists. Enabling requires an exact versioned tenant list.
AI_GATEWAY_LOCAL_CLIENT_SMART_MANAGE_SCHEDULER_ENABLED=false
# AI_GATEWAY_LOCAL_CLIENT_SMART_MANAGE_SCHEDULER_TENANTS_JSON={"version":1,"tenants":[{"tenantId":"<tenant-id>","subjectId":"<scheduler-subject-id>"}]}
# AI_GATEWAY_LOCAL_CLIENT_SMART_MANAGE_SCHEDULER_INTERVAL_MS=300000
# AI_GATEWAY_LOCAL_CLIENT_SMART_MANAGE_SCHEDULER_INITIAL_DELAY_MS=0
# AI_GATEWAY_LOCAL_CLIENT_SMART_MANAGE_SCHEDULER_BACKOFF_BASE_MS=30000
# AI_GATEWAY_LOCAL_CLIENT_SMART_MANAGE_SCHEDULER_BACKOFF_MAX_MS=1800000
# AI_GATEWAY_LOCAL_CLIENT_SMART_MANAGE_SCHEDULER_ROUND_DEADLINE_MS=120000
# AI_GATEWAY_LOCAL_CLIENT_SMART_MANAGE_SCHEDULER_MAX_CONCURRENCY=4
# AI_GATEWAY_LOCAL_CLIENT_SMART_MANAGE_SCHEDULER_MAX_TENANTS=256
# AI_GATEWAY_LOCAL_CLIENT_SMART_MANAGE_SCHEDULER_JITTER_RATIO=0.1
# Route plans default to in-memory preview. Select sqlite for restart-safe,
# same-host atomic create/get/consume; host id must be stable for this machine.
AI_GATEWAY_LOCAL_CLIENT_ROUTE_PLAN_STORE_MODE=memory
# AI_GATEWAY_LOCAL_CLIENT_ROUTE_PLAN_STORE_MODE=sqlite
# AI_GATEWAY_LOCAL_CLIENT_HOST_ID=<stable-non-secret-host-id>
# AI_GATEWAY_LOCAL_CLIENT_ROUTE_PLAN_SQLITE_PATH=.data/local-clients/route-plans.sqlite
# AI_GATEWAY_LOCAL_CLIENT_ROUTE_PLAN_TTL_MS=60000
# AI_GATEWAY_LOCAL_CLIENT_ROUTE_PLAN_MAX_ENTRIES=1024
# AI_GATEWAY_LOCAL_CLIENT_ROUTE_PLAN_MAX_INPUT_BYTES=65536
# AI_GATEWAY_LOCAL_CLIENT_ROUTE_PLAN_BUSY_TIMEOUT_MS=5000
# Execution claims default to disabled and are never inferred from another
# subsystem. Single-host execution requires explicit sqlite mode, the stable
# host id above, and a dedicated path distinct from the route-plan database.
AI_GATEWAY_LOCAL_CLIENT_EXECUTION_CLAIM_STORE_MODE=disabled
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_CLAIM_STORE_MODE=sqlite
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_CLAIM_SQLITE_PATH=.data/local-clients/execution-claims.sqlite
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_CLAIM_NAMESPACE=local-client-execution
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_CLAIM_TTL_MS=60000
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_CLAIM_MAX_CLAIMS=1024
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_CLAIM_BUSY_TIMEOUT_MS=5000
# SQLite claims are durable only on one host. Multi-instance execution remains
# blocked until a distributed fenced claim backend is explicitly configured.
# Feedback delivery dedup defaults to disabled. Governed local-client execution
# requires explicit single-host SQLite mode, a stable host id, and a dedicated
# path. Its HMAC key is domain-separated from authenticated adapter registry
# material and is never persisted. The store emits a leased aggregate delta but
# does not itself update EWMA, health, or routing state.
AI_GATEWAY_LOCAL_CLIENT_FEEDBACK_DEDUP_STORE_MODE=disabled
# AI_GATEWAY_LOCAL_CLIENT_FEEDBACK_DEDUP_STORE_MODE=sqlite
# AI_GATEWAY_LOCAL_CLIENT_FEEDBACK_DEDUP_SQLITE_PATH=.data/local-clients/feedback-dedup.sqlite
# AI_GATEWAY_LOCAL_CLIENT_FEEDBACK_DEDUP_NAMESPACE=local-client-feedback-dedup
# AI_GATEWAY_LOCAL_CLIENT_FEEDBACK_DEDUP_TTL_MS=604800000
# AI_GATEWAY_LOCAL_CLIENT_FEEDBACK_DEDUP_LEASE_TTL_MS=30000
# AI_GATEWAY_LOCAL_CLIENT_FEEDBACK_DEDUP_MAX_EVENTS=50000
# AI_GATEWAY_LOCAL_CLIENT_FEEDBACK_DEDUP_BUSY_TIMEOUT_MS=5000
# SQLite feedback dedup is rejected in multi-instance mode and its path must be
# distinct from registry, route-plan, claim, authority, idempotency, external-
# effect, and provider-dispatch stores.
# Verified execution feedback is staged before lifecycle completion in a
# durable single-host outbox. Delivery is at-least-once; the SQLite feedback
# dedup store makes the aggregate mutation exactly once. Pending rows are never
# expired, and delivery failure never authorizes execution replay.
AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_OUTBOX_STORE_MODE=disabled
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_OUTBOX_STORE_MODE=sqlite
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_OUTBOX_SQLITE_PATH=.data/local-clients/execution-feedback-outbox.sqlite
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_OUTBOX_NAMESPACE=local-client-execution-feedback-outbox
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_OUTBOX_DELIVERED_TTL_MS=604800000
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_OUTBOX_LEASE_TTL_MS=30000
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_OUTBOX_MAX_EVENTS=50000
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_OUTBOX_MAX_BATCH_SIZE=100
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_OUTBOX_BUSY_TIMEOUT_MS=5000
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_DISPATCH_INTERVAL_MS=1000
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_DELIVERY_TIMEOUT_MS=5000
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_DISPATCH_BATCH_SIZE=4
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_FEEDBACK_DISPATCH_MAX_BATCHES=4
# The lease TTL must exceed batch-size * delivery-timeout + SQLite busy-timeout
# plus the enforced safety margin. This database is HMAC protected but not
# resistant to restoring a complete older database snapshot; an external
# protected anchor remains a release gate. Keep its path distinct from every
# other state store.
# Gateway-side dispatch intents and client durable receipts use a separate
# per-client SQLite journal. Governed execution requires this mode. Each file
# is keyed and AES-256-GCM encrypts only the minimum restart context; raw action
# input, response, provider secret, tenant, subject, and client values are not
# stored in plaintext. The client must implement the matching v2 protocol and
# durably claim executionId before performing an effect.
AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECONCILIATION_STORE_MODE=disabled
# AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECONCILIATION_STORE_MODE=sqlite
# AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECONCILIATION_DIR=.data/local-clients/receipt-journals
# AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECONCILIATION_NAMESPACE=local-client-execution-receipts
# AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECONCILIATION_MAX_ENTRIES=2000
# AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECONCILIATION_RETENTION_MS=604800000
# AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECONCILIATION_INTENT_TTL_MS=60000
# AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECONCILIATION_QUERY_TTL_MS=30000
# AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECONCILIATION_CLOCK_SKEW_MS=5000
# AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECONCILIATION_BUSY_TIMEOUT_MS=5000
# AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECOVERY_INTERVAL_MS=5000
# AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECOVERY_BATCH_SIZE=32
# AI_GATEWAY_LOCAL_CLIENT_RECEIPT_RECOVERY_GRACE_MS=120000
# Intent TTL, query TTL, and recovery grace must each be at least the largest
# loopback timeout plus clock skew plus a one-second safety margin.
# This closes gateway-side receipt loss through query-only reconciliation, but
# complete effect/receipt atomicity remains a client implementation contract.
# Signed-registry generations default to no monotonic checkpoint. Governed
# execution requires explicit single-host SQLite mode. The gateway derives a
# dedicated checkpoint HMAC key from authenticated adapter credential material;
# it never persists the raw key. Keep this database path distinct from registry,
# route-plan, claim, idempotency, and external-effect state.
AI_GATEWAY_LOCAL_CLIENT_AUTHORITY_EPOCH_STORE_MODE=disabled
# AI_GATEWAY_LOCAL_CLIENT_AUTHORITY_EPOCH_STORE_MODE=sqlite
# AI_GATEWAY_LOCAL_CLIENT_AUTHORITY_EPOCH_SQLITE_PATH=.data/local-clients/verification-authority-epoch.sqlite
# AI_GATEWAY_LOCAL_CLIENT_AUTHORITY_EPOCH_NAMESPACE=local-client-verification-authority
# AI_GATEWAY_LOCAL_CLIENT_AUTHORITY_EPOCH_MAX_CHECKPOINTS=32
# AI_GATEWAY_LOCAL_CLIENT_AUTHORITY_EPOCH_BUSY_TIMEOUT_MS=5000
# This detects restoring only an older signed registry. It is not protected
# against restoring both registry and checkpoint DB to the same older snapshot.
# A real loopback adapter is registered only when every identity and credential
# reference below is explicit. The secret value must be `hex:` plus 32-64 bytes
# and should be referenced from CREDENTIAL_VAULT_DIR, not written here.
AI_GATEWAY_LOCAL_CLIENT_LOOPBACK_ENABLED=false
# Legacy single-client form:
# AI_GATEWAY_LOCAL_CLIENT_LOOPBACK_ADAPTER_ID=builtin.loopback.local-client
# AI_GATEWAY_LOCAL_CLIENT_LOOPBACK_ENDPOINT=http://127.0.0.1:43120
# AI_GATEWAY_LOCAL_CLIENT_LOOPBACK_CLIENT_ID=managed.local-client
# AI_GATEWAY_LOCAL_CLIENT_LOOPBACK_TENANT_ID=<exact-owning-tenant-id>
# AI_GATEWAY_LOCAL_CLIENT_LOOPBACK_MANIFEST_SHA256=<64-lowercase-hex>
# AI_GATEWAY_LOCAL_CLIENT_LOOPBACK_SECRET_REF=file_key_path:local-client-loopback.hex
# Each configured loopback secret also derives a separate per-tenant/client PoP
# key. Managed heartbeat/feedback and opt-in protocol dispatch bind the current
# verified revision, authenticated subject, HTTP method/path, exact raw body,
# time window, and one-use nonce. Raw adapter secrets and derived keys are never
# returned by status routes.
# AI_GATEWAY_LOCAL_CLIENT_LOOPBACK_TIMEOUT_MS=5000
# AI_GATEWAY_LOCAL_CLIENT_LOOPBACK_CHALLENGE_TTL_MS=2000
# AI_GATEWAY_LOCAL_CLIENT_LOOPBACK_VERIFICATION_TTL_MS=300000
# AI_GATEWAY_LOCAL_CLIENT_LOOPBACK_MAX_RESPONSE_BYTES=16384
# Versioned multi-client form. Do not combine it with the legacy fields above;
# adapterId and tenantId+clientId ownership pairs must be unique (max 64).
# AI_GATEWAY_LOCAL_CLIENT_LOOPBACK_ADAPTERS_JSON={"version":1,"adapters":[{"adapterId":"loopback.desktop.one","tenantId":"tenant-a","clientId":"desktop.one","endpoint":"http://127.0.0.1:43120","manifestSha256":"<64-lowercase-hex>","secretRef":"file_key_path:desktop-one.hex"}]}
# Every enabled loopback configuration requires a dedicated gateway-only
# registry-authority reference whose bytes differ from every client loopback
# secret. It authenticates the registry and independently derives receipt-file
# naming, gateway journal integrity, and recovery-context encryption. Only the
# reconciliation wire key derives from the corresponding client-shared secret.
# Rotating the gateway authority intentionally fails the prior registry closed;
# rotate client secrets only through an explicit journal migration/reconciliation
# procedure. Raw references, fingerprints, and derived keys are never exposed.
# AI_GATEWAY_LOCAL_CLIENT_REGISTRY_INTEGRITY_SECRET_REF=file_key_path:local-client-registry.hex
# HMAC plus the separate epoch DB detects registry-only replay;
# service-account/OS or remote/hardware anchoring remains required to resist a
# coordinated rollback of both local files.
# Managed-client PoP nonce replay protection defaults to process memory and is
# suitable only for the credential-free, single-process fake-provider path.
# SQLite mode is required for any future real-provider managed dispatch, but is
# not sufficient by itself: restoring a complete older database snapshot is
# outside its HMAC boundary, so real-provider dispatch remains blocked until an
# external monotonic anchor is composed. The database stores only keyed replay
# fingerprints and expiry metadata.
AI_GATEWAY_LOCAL_CLIENT_POP_REPLAY_STORE_MODE=memory
# AI_GATEWAY_LOCAL_CLIENT_POP_REPLAY_STORE_MODE=sqlite
# AI_GATEWAY_LOCAL_CLIENT_POP_REPLAY_SQLITE_PATH=.data/local-clients/pop-replay.sqlite
# AI_GATEWAY_LOCAL_CLIENT_POP_REPLAY_NAMESPACE=local-client-pop-replay
# AI_GATEWAY_LOCAL_CLIENT_POP_REPLAY_MAX_ENTRIES=10000
# AI_GATEWAY_LOCAL_CLIENT_POP_REPLAY_MAX_ENTRIES_PER_SCOPE=1000
# AI_GATEWAY_LOCAL_CLIENT_POP_REPLAY_BUSY_TIMEOUT_MS=5000
# SQLite PoP replay protection is durable across restarts and atomic across
# processes sharing one local file, but is not distributed across hosts. Keep
# its path distinct from every registry, outbox, and other SQLite state store.
# Local-client approval/lifecycle control uses an isolated directory/namespace.
# The currently composed synchronous single-host runtime requires atomic local
# JSON. PostgreSQL control remains a future async-readiness/cross-host gate.
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_CONTROL_DIR=.data/local-clients/execution-control
# AI_GATEWAY_LOCAL_CLIENT_CONTROL_STORE_MODE=local
# AI_GATEWAY_LOCAL_CLIENT_CONTROL_CENTRAL_REQUIRED=false
# AI_GATEWAY_LOCAL_CLIENT_CONTROL_NAMESPACE=local-client
# AI_GATEWAY_LOCAL_CLIENT_CONTROL_POSTGRES_URL=<load-from-secret-manager>?sslmode=verify-full
# AI_GATEWAY_LOCAL_CLIENT_CONTROL_POSTGRES_TLS_REQUIRED=true
# AI_GATEWAY_LOCAL_CLIENT_CONTROL_POSTGRES_POOL_MAX=4
# AI_GATEWAY_LOCAL_CLIENT_CONTROL_POSTGRES_STATEMENT_TIMEOUT_MS=5000
# AI_GATEWAY_LOCAL_CLIENT_REGISTRY_PATH=.data/local-clients/registry.json
# AI_GATEWAY_LOCAL_CLIENT_EXECUTION_LOG_PATH=.data/local-clients/execution-log.jsonl
# AI_GATEWAY_LOCAL_CLIENT_DISCOVERY_HINTS_PATH=.data/local-clients/discovery-hints.json

# Governed MCP onboarding is default-off and lazy: application construction
# validates this code-owned configuration but does not open, create, inspect, or
# modify any client target. The first protected onboarding API call initializes
# the three JSON-only profiles. This fixture-tested integration is not real-
# client certification and supports no JSONC/YAML files.
AI_GATEWAY_LOCAL_CLIENT_ONBOARDING_ENABLED=false
# AI_GATEWAY_LOCAL_CLIENT_ONBOARDING_CONFIG_JSON={"version":1,"ownerTenantId":"<exact-owning-tenant-id>","profiles":{"claudeCompatible":{"targetPath":"<absolute-json-path>","allowedRoot":"<absolute-root>","backupDir":"<absolute-backup-dir>","journalPath":"<absolute-journal-path>"},"cursor":{"targetPath":"<absolute-json-path>","allowedRoot":"<absolute-root>","backupDir":"<absolute-backup-dir>","journalPath":"<absolute-journal-path>"},"vscode":{"targetPath":"<absolute-json-path>","allowedRoot":"<absolute-root>","backupDir":"<absolute-backup-dir>","journalPath":"<absolute-journal-path>"}},"serverDefinition":{"transport":"stdio","command":"<absolute-command>","args":["<gateway-entry>"]}}
# AI_GATEWAY_LOCAL_CLIENT_HOST_ID=<stable-non-secret-host-id>
# AI_GATEWAY_LOCAL_CLIENT_ONBOARDING_RECEIPT_AUTHORITY_SQLITE_PATH=.data/local-clients/onboarding-receipt-authority.sqlite
# AI_GATEWAY_LOCAL_CLIENT_ONBOARDING_RECEIPT_AUTHORITY_NAMESPACE=local-client-onboarding-receipt-authority
# AI_GATEWAY_LOCAL_CLIENT_ONBOARDING_RECEIPT_AUTHORITY_TTL_MS=2592000000
# AI_GATEWAY_LOCAL_CLIENT_ONBOARDING_RECEIPT_AUTHORITY_LEASE_TTL_MS=600000
# AI_GATEWAY_LOCAL_CLIENT_ONBOARDING_RECEIPT_AUTHORITY_MAX_ROWS=10000
# AI_GATEWAY_LOCAL_CLIENT_ONBOARDING_RECEIPT_AUTHORITY_BUSY_TIMEOUT_MS=5000
# AI_GATEWAY_LOCAL_CLIENT_ONBOARDING_ROOT_SECRET_REF=file_key_path:local-client-onboarding-root.hex
# When enabled, onboarding requires single-instance local approval control plus
# explicit SQLite AI_GATEWAY_IDEMPOTENCY_* and AI_GATEWAY_EXTERNAL_EFFECT_*
# paths/secrets. Idempotency requires its direct stable secret; external-effect
# accepts either its direct secret or explicit local HMAC secret path. It does
# not require execution route-plan, claim, or authority-
# epoch stores. Governance database paths must not overlap any configured client
# target, journal, or backup directory. Onboarding automatically enables the
# external-effect gate. Every onboarding operation is denied unless the
# authenticated tenant exactly matches ownerTenantId; status never returns it.
# The dedicated onboarding root credential is domain-separated into an
# AES-256-GCM backup key and a receipt-authority HMAC key. Keep it stable for at
# least the full receipt/backup retention window; rotation without migration
# fails closed. Full prior client JSON is encrypted at
# rest; obvious credential-bearing command arguments are rejected. Receipt TTL
# is also the exact committed-backup rollback retention window.

# A2A Agent Card signing is optional for local fake-provider preview. Production
# deployments can require a stable Ed25519 PKCS#8 private key mounted from a
# secret store. The key path must be absolute and mode 0600 on POSIX systems.
AI_GATEWAY_A2A_AGENT_CARD_SIGNING_REQUIRED=false
# AI_GATEWAY_A2A_AGENT_CARD_SIGNING_KEY_FILE=/run/secrets/a2a-agent-card-ed25519.pem
# During a bounded rotation window, add at most three old absolute key paths.
# The gateway signs with every key and publishes public JWKs in primary-first order.
# AI_GATEWAY_A2A_AGENT_CARD_PREVIOUS_SIGNING_KEY_FILES_JSON=["/run/secrets/a2a-agent-card-old.pem"]
# Defaults to <A2A_PUBLIC_BASE_URL>/.well-known/a2a-jwks.json. Non-loopback
# signing/JWKS URLs must use HTTPS.
# AI_GATEWAY_A2A_AGENT_CARD_JWKS_URL=https://gateway.example.com/.well-known/a2a-jwks.json

# A2A task storage is bounded in every mode. Local preview defaults to an
# in-memory SQLite database. Multi-instance mode defaults to same-host SQLite;
# cross-host replicas must explicitly select PostgreSQL. SQLite stays local.
AI_GATEWAY_A2A_TASK_STORE_REQUIRED=false
# AI_GATEWAY_A2A_TASK_STORE_MODE=sqlite
# AI_GATEWAY_A2A_TASK_STORE_PATH=/var/lib/unified-ai-system/a2a-tasks.sqlite
# AI_GATEWAY_A2A_TASK_STORE_CENTRAL_REQUIRED=false
# AI_GATEWAY_A2A_TASK_STORE_POSTGRES_URL=<load-from-secret-manager>?sslmode=verify-full
# AI_GATEWAY_A2A_TASK_STORE_NAMESPACE=default
# AI_GATEWAY_A2A_TASK_STORE_POSTGRES_POOL_MAX=4
# AI_GATEWAY_A2A_TASK_STORE_POSTGRES_STATEMENT_TIMEOUT_MS=5000
# PostgreSQL task mode automatically requires a fenced execution lease. The
# lease URL defaults to the task-store URL and must resolve to the same DB.
# AI_GATEWAY_A2A_EXECUTION_LEASE_MODE=postgres
# AI_GATEWAY_A2A_EXECUTION_LEASE_REQUIRED=true
# AI_GATEWAY_A2A_EXECUTION_LEASE_POSTGRES_URL=<load-from-secret-manager>?sslmode=verify-full
# AI_GATEWAY_A2A_EXECUTION_LEASE_TTL_MS=300000
# AI_GATEWAY_A2A_EXECUTION_LEASE_HEARTBEAT_MS=100000
# AI_GATEWAY_A2A_EXECUTION_LEASE_MAX_ENTRIES=10000
# AI_GATEWAY_A2A_EXECUTION_LEASE_POSTGRES_POOL_MAX=4
# AI_GATEWAY_A2A_EXECUTION_LEASE_POSTGRES_STATEMENT_TIMEOUT_MS=5000
# AI_GATEWAY_A2A_TERMINAL_COMMIT_GRACE_MS=10000
# AI_GATEWAY_A2A_TASK_TTL_MS=604800000
# AI_GATEWAY_A2A_TASK_MAX_ENTRIES=10000
# AI_GATEWAY_A2A_TASK_MAX_ENTRIES_PER_OWNER=2000
# AI_GATEWAY_A2A_TASK_MAX_BYTES=4194304
# AI_GATEWAY_A2A_TASK_MAX_HISTORY_MESSAGES=500
# AI_GATEWAY_A2A_TASK_MAX_ARTIFACTS=100
# AI_GATEWAY_A2A_TASK_SQLITE_BUSY_TIMEOUT_MS=5000

# Workforce execution remains off by default. A real multi-instance execution
# deployment must use PostgreSQL claims plus the central queue/result store;
# the gateway fails startup if ownership or task state would stay process-local.
WORKFORCE_EXECUTION_ENABLED=false
AI_GATEWAY_WORKFORCE_CLAIM_STORE_REQUIRED=false
# AI_GATEWAY_WORKFORCE_CLAIM_STORE_MODE=postgres
# AI_GATEWAY_WORKFORCE_CLAIM_POSTGRES_URL=<load-from-secret-manager>?sslmode=verify-full
# AI_GATEWAY_WORKFORCE_CLAIM_NAMESPACE=default
# AI_GATEWAY_WORKFORCE_CLAIM_POSTGRES_TLS_REQUIRED=true
# AI_GATEWAY_WORKFORCE_CLAIM_POSTGRES_POOL_MAX=4
# AI_GATEWAY_WORKFORCE_CLAIM_POSTGRES_STATEMENT_TIMEOUT_MS=5000
# AI_GATEWAY_WORKFORCE_QUEUE_STORE_MODE=postgres
# AI_GATEWAY_WORKFORCE_QUEUE_CENTRAL_REQUIRED=false
# AI_GATEWAY_WORKFORCE_QUEUE_POSTGRES_URL=<same-database-as-claims>?sslmode=verify-full
# AI_GATEWAY_WORKFORCE_QUEUE_NAMESPACE=default
# AI_GATEWAY_WORKFORCE_QUEUE_POSTGRES_TLS_REQUIRED=true
# AI_GATEWAY_WORKFORCE_QUEUE_POSTGRES_POOL_MAX=4
# AI_GATEWAY_WORKFORCE_QUEUE_POSTGRES_STATEMENT_TIMEOUT_MS=5000
# AI_GATEWAY_WORKFORCE_QUEUE_RETENTION_MS=2592000000
# AI_GATEWAY_WORKFORCE_QUEUE_MAX_ENTRIES=3000
# AI_GATEWAY_WORKFORCE_QUEUE_MAX_TASK_BYTES=1048576
# AI_GATEWAY_WORKFORCE_CONTROL_STORE_MODE=postgres
# AI_GATEWAY_WORKFORCE_CONTROL_CENTRAL_REQUIRED=false
# AI_GATEWAY_WORKFORCE_CONTROL_POSTGRES_URL=<same-database-as-queue-and-claims>?sslmode=verify-full
# AI_GATEWAY_WORKFORCE_CONTROL_NAMESPACE=default
# AI_GATEWAY_WORKFORCE_CONTROL_POSTGRES_TLS_REQUIRED=true
# AI_GATEWAY_WORKFORCE_CONTROL_POSTGRES_POOL_MAX=4
# AI_GATEWAY_WORKFORCE_CONTROL_POSTGRES_STATEMENT_TIMEOUT_MS=5000
# AI_GATEWAY_WORKFORCE_CONTROL_APPROVAL_TTL_MS=86400000
# AI_GATEWAY_WORKFORCE_CONTROL_RETENTION_MS=2592000000
# AI_GATEWAY_WORKFORCE_CONTROL_MAX_APPROVALS=10000
# AI_GATEWAY_WORKFORCE_CONTROL_MAX_EXECUTIONS=10000
# AI_GATEWAY_WORKFORCE_CONTROL_MAX_STATE_BYTES=1048576
# AI_GATEWAY_WORKFORCE_CONTROL_POLL_MS=500
# WORKFORCE_ABORT_DRAIN_TIMEOUT_MS=30000

AI_GATEWAY_REQUEST_TIMEOUT_MS=60000
AI_GATEWAY_STREAMING_REQUEST_TIMEOUT_MS=300000
AI_GATEWAY_MAX_IN_FLIGHT_REQUESTS=500
AI_GATEWAY_MAX_REQUEST_BODY_BYTES=2097152
AI_GATEWAY_HEALTHZ_IN_FLIGHT_DEGRADATION_PERCENT=90
AI_GATEWAY_GATEWAY_ERROR_CIRCUIT_FAILURE_THRESHOLD=12
AI_GATEWAY_GATEWAY_ERROR_CIRCUIT_SUCCESS_THRESHOLD=2
AI_GATEWAY_GATEWAY_ERROR_CIRCUIT_RESET_MS=30000
AI_GATEWAY_GATEWAY_ERROR_CIRCUIT_HALF_OPEN_MAX_CALLS=2
AI_GATEWAY_GATEWAY_ERROR_CIRCUIT_BYPASS_ROUTES=/health,/health/check,/healthz,/ready,/setup/readiness,/metrics
AI_GATEWAY_CONSOLE_TIMEOUT_MS=60000
AI_GATEWAY_CONTENT_GUARDRAILS_MODE=block
AI_GATEWAY_COST_GUARD_ENFORCE=true
# Real-provider shadow calls are separately opt-in and always enter the cost ledger.
AI_GATEWAY_SHADOW_REAL_PROVIDER_ENABLED=false
AI_GATEWAY_SHADOW_TIMEOUT_MS=30000
# Set true only when using the Phase 8A streaming console path.
AI_GATEWAY_CONSOLE_STREAM=false

# OpenTelemetry tracing is in-process only unless an OTLP endpoint is explicit.
# Prompt and output content are never attached to spans.
AI_GATEWAY_OTEL_ENABLED=true
AI_GATEWAY_OTEL_SERVICE_NAME=unified-ai-gateway
AI_GATEWAY_OTEL_SAMPLE_RATIO=1
AI_GATEWAY_OTEL_EXPORTER_MODE=batch
AI_GATEWAY_OTEL_EXPORT_TIMEOUT_MS=10000
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# HTTP rate limiting (safe defaults, optional tuning)
# Set false to keep legacy single global limiter.
AI_GATEWAY_ROUTE_RATE_LIMIT_ENABLED=true
AI_GATEWAY_RATE_LIMIT_WINDOW_MS=60000
AI_GATEWAY_RATE_LIMIT_MAX_REQUESTS=120
AI_GATEWAY_RATE_LIMIT_STORE_MODE=memory
# AI_GATEWAY_RATE_LIMIT_STORE_PATH=.data/rate-limits.sqlite
AI_GATEWAY_RATE_LIMIT_STORE_NAMESPACE=http
AI_GATEWAY_RATE_LIMIT_SUBJECT_MODE=network
# Trust only direct reverse proxies/load balancers that overwrite X-Forwarded-For.
# For deploy/nginx.conf on the same host: 127.0.0.1/32,::1/128
AI_GATEWAY_TRUSTED_PROXY_CIDRS=
AI_GATEWAY_MAX_FORWARDED_HOPS=32
# Cross-host rate-limit mode only; load both values from a secret manager and require verified TLS:
# AI_GATEWAY_RATE_LIMIT_POSTGRES_URL=<set-in-local-secret-store>
# AI_GATEWAY_RATE_LIMIT_HMAC_SECRET=<set-32-byte-or-longer-secret-in-local-secret-store>
# AI_GATEWAY_RATE_LIMIT_POSTGRES_POOL_MAX=4
# AI_GATEWAY_RATE_LIMIT_POSTGRES_STATEMENT_TIMEOUT_MS=5000
# AI_GATEWAY_RATE_LIMIT_POSTGRES_MAX_BUCKETS=100000
# PostgreSQL mode also enables fail-closed cross-replica WebSocket connection leases.
# AI_GATEWAY_WEBSOCKET_CONNECTION_LEASE_NAMESPACE=default
# AI_GATEWAY_WEBSOCKET_CONNECTION_LEASE_MS=30000
# AI_GATEWAY_WEBSOCKET_CONNECTION_LEASE_MAX_ROWS=100000
# AI_GATEWAY_WEBSOCKET_CONNECTION_LEASE_POOL_MAX=2
# Keep empty in internet-facing deployments. Add exemptions only after explicit review.
AI_GATEWAY_RATE_LIMIT_WHITELIST=

# POST /chat and governed local-client execution share this HTTP idempotency
# coordinator. Keep memory for credential-free preview/chat use. Opt-in local-
# client execution currently fails closed unless this is sqlite and the HMAC
# secret is stable and at least 32 bytes. PostgreSQL remains supported for other
# gateway routes but is not yet accepted by the synchronous local-client startup
# gate. SQLite requires the explicit path below, separate from route-plan and
# execution-claim databases.
AI_GATEWAY_IDEMPOTENCY_STORE_MODE=memory
# AI_GATEWAY_IDEMPOTENCY_STORE_MODE=sqlite
# AI_GATEWAY_IDEMPOTENCY_STORE_MODE=postgres
AI_GATEWAY_IDEMPOTENCY_TTL_MS=600000
AI_GATEWAY_IDEMPOTENCY_MAX_ENTRIES=1000
AI_GATEWAY_IDEMPOTENCY_MAX_RESULT_BYTES=1048576
AI_GATEWAY_IDEMPOTENCY_LEASE_MS=300000
AI_GATEWAY_IDEMPOTENCY_WAIT_MS=30000
AI_GATEWAY_IDEMPOTENCY_POLL_MS=50
# Same-host, restart-safe mode only:
# AI_GATEWAY_IDEMPOTENCY_SQLITE_PATH=.data/idempotency.sqlite
# Both durable modes require a stable secret loaded from a secret manager:
# AI_GATEWAY_IDEMPOTENCY_HMAC_SECRET=<set-32-byte-or-longer-secret-in-local-secret-store>
# Cross-host mode only; load the URL from a secret manager and require verified TLS:
# AI_GATEWAY_IDEMPOTENCY_POSTGRES_URL=<set-in-local-secret-store>
# AI_GATEWAY_IDEMPOTENCY_POSTGRES_POOL_MAX=4
# AI_GATEWAY_IDEMPOTENCY_POSTGRES_STATEMENT_TIMEOUT_MS=5000

# Every real-provider GatewayService attempt requires a durable dispatch
# reservation before any external call. SQLite is the single-host default;
# multi-instance real-provider deployments must use PostgreSQL.
AI_GATEWAY_PROVIDER_DISPATCH_KEY_REQUIRED=true
# AI_GATEWAY_PROVIDER_DISPATCH_STORE_MODE=sqlite
# AI_GATEWAY_PROVIDER_DISPATCH_SQLITE_PATH=.data/provider-dispatch.sqlite
# AI_GATEWAY_PROVIDER_DISPATCH_HMAC_SECRET=<set-32-byte-or-longer-secret-in-local-secret-store>
# AI_GATEWAY_PROVIDER_DISPATCH_HMAC_SECRET_PATH=.data/provider-dispatch-hmac.key
# AI_GATEWAY_PROVIDER_DISPATCH_TTL_MS=86400000
# AI_GATEWAY_PROVIDER_DISPATCH_MAX_ENTRIES=100000
# AI_GATEWAY_PROVIDER_DISPATCH_CENTRAL_REQUIRED=true
# AI_GATEWAY_PROVIDER_DISPATCH_POSTGRES_URL=<load-from-secret-manager>?sslmode=verify-full
# AI_GATEWAY_PROVIDER_DISPATCH_POSTGRES_TLS_REQUIRED=true

# Irreversible webhooks and high-risk agent tools require a separate durable
# tombstone before the sink. A configured Feishu/WeCom webhook or non-empty MCP
# upstream registry auto-enables the gate. Multi-instance deployments must use
# PostgreSQL in the Workforce DB. Governed local-client execution also
# auto-enables this gate; its currently composed single-host path requires an
# explicit SQLite store while async PostgreSQL readiness remains a release gate.
# AI_GATEWAY_EXTERNAL_EFFECT_ENABLED=true
# AI_GATEWAY_EXTERNAL_EFFECT_STORE_MODE=sqlite
# AI_GATEWAY_EXTERNAL_EFFECT_SQLITE_PATH=.data/external-effects.sqlite
# AI_GATEWAY_EXTERNAL_EFFECT_HMAC_SECRET=<set-32-byte-or-longer-secret-in-local-secret-store>
# AI_GATEWAY_EXTERNAL_EFFECT_HMAC_SECRET_PATH=.data/external-effects-hmac.key
# AI_GATEWAY_EXTERNAL_EFFECT_TTL_MS=86400000
# AI_GATEWAY_EXTERNAL_EFFECT_MAX_ENTRIES=100000
# AI_GATEWAY_EXTERNAL_EFFECT_CENTRAL_REQUIRED=true
# AI_GATEWAY_EXTERNAL_EFFECT_POSTGRES_URL=<same-database-as-workforce>?sslmode=verify-full
# AI_GATEWAY_EXTERNAL_EFFECT_POSTGRES_TLS_REQUIRED=true

# Billable usage evidence. One real-provider process may use durable fsynced
# files. Multi-instance real-provider execution requires the central PostgreSQL
# ledger and fails closed before a provider call when it is unavailable.
# AI_GATEWAY_USAGE_LEDGER_STORE_MODE=postgres
# AI_GATEWAY_USAGE_LEDGER_CENTRAL_REQUIRED=true
# AI_GATEWAY_USAGE_LEDGER_POSTGRES_URL=<load-from-secret-manager>?sslmode=verify-full
# AI_GATEWAY_USAGE_LEDGER_NAMESPACE=default
# AI_GATEWAY_USAGE_LEDGER_POSTGRES_TLS_REQUIRED=true
# AI_GATEWAY_USAGE_LEDGER_POSTGRES_MAX_ROWS=1000000
# AI_GATEWAY_USAGE_LEDGER_POSTGRES_RETENTION_DAYS=90
# AI_GATEWAY_USAGE_LEDGER_POSTGRES_POOL_MAX=4
# AI_GATEWAY_USAGE_LEDGER_POSTGRES_STATEMENT_TIMEOUT_MS=5000

# Cross-host enterprise audit. Local/single-host deployments retain the signed
# file checkpoint. Multi-instance real-provider deployments require this
# append-only PostgreSQL HMAC chain as the canonical shared audit source.
# PME_AUDIT_STORE_MODE=postgres
# PME_AUDIT_CENTRAL_REQUIRED=true
# PME_AUDIT_POSTGRES_URL=<load-from-secret-manager>?sslmode=verify-full
# PME_AUDIT_POSTGRES_NAMESPACE=default
# PME_AUDIT_POSTGRES_HMAC_KEY_FILE=/run/secrets/audit-postgres-hmac.key
# PME_AUDIT_POSTGRES_TLS_REQUIRED=true
# PME_AUDIT_POSTGRES_MAX_ROWS=10000000
# PME_AUDIT_POSTGRES_POOL_MAX=4
# PME_AUDIT_POSTGRES_STATEMENT_TIMEOUT_MS=5000
# PME_AUDIT_POSTGRES_MINIMUM_SEQUENCE=<externally-recorded-floor>
# PME_AUDIT_POSTGRES_TRUSTED_HASH=<hash-at-that-sequence>

AI_GATEWAY_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
AI_GATEWAY_CORS_MAX_AGE_SECONDS=86400
# Optional JSON for per-route override, e.g. override limits for chat endpoints.
# Example:
# AI_GATEWAY_ROUTE_RATE_LIMITS={"/chat":{"windowMs":60000,"maxRequests":20}}

# ── Optional toggles ──────────────────────────────────────────────────────
# AI_GATEWAY_FALLBACK_ENABLED=true
# AI_GATEWAY_FAKE_PRIMARY_FAIL=false

# Forge inside the gateway is bound to the governed in-process provider lane.
# Standalone smart calls fail closed unless direct fallback is explicitly enabled.
FORGE_DIRECT_PROVIDER_FALLBACK_ENABLED=false
